{
  "name": "mentatus",
  "version": "0.1.0",
  "private": true,
  "homepage": "",
  "author": "Denis Zakharchenko",
  "license": "Apache 2.0",
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^2.0.0",
    "globals": "^17.14.0",
    "husky": "^1.3.1",
    "jsdom": "^26.1.0",
    "lint-staged": "^8.1.0",
    "prettier": "^1.16.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,json,css}": [
      "prettier --write",
      "git add"
    ]
  }
}
